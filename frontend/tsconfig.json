    "../static/js/runtime_request_config.js",
    "../static/js/run_state_store.js",
    "../static/js/run_stream_request.js",
    "../static/js/state.js",
    "../static/js/streams.js",
    "../static/js/structured_model_dot.js"
  ]
}
